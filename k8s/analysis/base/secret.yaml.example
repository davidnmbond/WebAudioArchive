# TEMPLATE ONLY. The extension .example is deliberate: kubectl apply -f <folder> and kustomize ignore it, so it cannot be
# applied by accident, and it is not listed in kustomization.yaml. Every value below is a placeholder, never a real token.
# Both entries are optional (the Deployment marks the Secret optional): create the Secret only if a TLS proxy in front of
# the GPU servers asks for bearer tokens. Create it from the command line so the values never reach git:
#   kubectl -n <namespace> create secret generic waa-analysis-secrets \
#     --from-literal=WAA_WHISPER_TOKEN='<paste the token>' --from-literal=WAA_OLLAMA_TOKEN='<paste the token>'
apiVersion: v1
kind: Secret
metadata:
  name: waa-analysis-secrets
type: Opaque
stringData:
  WAA_WHISPER_TOKEN: "REPLACE_ME_placeholder_not_a_real_token"
  WAA_OLLAMA_TOKEN: "REPLACE_ME_placeholder_not_a_real_token"
