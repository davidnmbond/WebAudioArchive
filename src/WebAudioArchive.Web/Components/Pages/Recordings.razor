@page "/recordings"

<PageTitle>Recordings - WebAudioArchive</PageTitle>

<h1 class="h3">Recordings</h1>
<p class="text-body-secondary">Every master segment of station <strong>@Settings.Station</strong> from every recorder, newest first. All times are UTC.</p>

<PDToolbar CssClass="mb-3 align-items-end">
    <PDToolbarPlaceholder>
        <PDToggleSwitch Id="recordings-filter" Label="Only one UTC date" Value="@Filtering" ValueChanged="OnFilteringChangedAsync" />
    </PDToolbarPlaceholder>
    <PDToolbarPlaceholder>
        <UtcDatePicker Id="recordings-date" Label="Date (UTC)" Value="FilterDate" ValueChanged="OnDateChangedAsync" Fallback="Today" IsEnabled="Filtering" />
    </PDToolbarPlaceholder>
    <PDToolbarButton Key="reload" Text="Reload" IconCssClass="fas fa-sync-alt" CssClass="btn-outline-secondary" Size="ButtonSizes.Small" Click="_ => ReloadAsync()" />
    <PDToolbarPlaceholder>
        <span class="text-body-secondary small" id="recordings-count">@Provider.Rows.Count segments@(Filtering && FilterDate is not null ? " on " + FilterDate.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) + " UTC" : "")</span>
    </PDToolbarPlaceholder>
</PDToolbar>

<div class="table-responsive">
<PDTable @ref="Table"
         TItem="RecordingRow"
         Id="recordings-table"
         DataProvider="Provider"
         KeyField="r => r.Key"
         SortCriteria="Sort"
         PageCriteria="Paging"
         PageSizeChoices="PageSizes"
         ShowOverlay="false"
         NoDataMessage="No recordings found.">
    <PDColumn TItem="RecordingRow" Id="recorder" Field="r => r.Recorder" Title="Recorder" />
    <PDColumn TItem="RecordingRow" Id="start" Field="r => r.StartUtc" Title="Start (UTC)" Format="yyyy-MM-dd HH:mm:ss" />
    <PDColumn TItem="RecordingRow" Id="end" Field="r => r.EndUtc" Title="End (UTC)" Format="yyyy-MM-dd HH:mm:ss" />
    <PDColumn TItem="RecordingRow" Id="duration" Field="r => r.AudioSeconds" Title="Audio duration">
        <Template Context="row">@row.Duration</Template>
    </PDColumn>
    <PDColumn TItem="RecordingRow" Id="size" Field="r => r.SizeMb" Title="Size (MB)" Format="0.00" />
    <PDColumn TItem="RecordingRow" Id="endedBy" Field="r => r.EndedBy" Title="Ended by" />
    <PDColumn TItem="RecordingRow" Id="gaps" Field="r => r.Gaps" Title="Gaps" />
    <PDColumn TItem="RecordingRow" Id="open" Field="r => r.Open" Title="Open" />
    <PDColumn TItem="RecordingRow" Id="play" Title="Play" Sortable="false">
        <Template Context="row"><PDLinkButton Url="@row.PlayerUrl" Text="Play" IconCssClass="fas fa-play" CssClass="btn-primary" Size="ButtonSizes.Small" ToolTip="Open this segment in the Player" /></Template>
    </PDColumn>
</PDTable>
</div>
