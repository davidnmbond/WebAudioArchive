@page "/"
@implements IDisposable

<PageTitle>Status - WebAudioArchive</PageTitle>

<h1 class="h3">Status</h1>
<PDToolbar CssClass="mb-3">
    <PDToolbarPlaceholder>
        <span class="text-body-secondary toolbar-text">Station <strong>@Settings.Station</strong>. Checked at <span class="utc">@CheckedText</span>; refreshes every @RefreshSeconds s.</span>
    </PDToolbarPlaceholder>
    <PDToolbarButton Key="refresh" Text="Refresh now" IconCssClass="fas fa-sync-alt" CssClass="btn-outline-secondary" Size="ButtonSizes.Small" Click="_ => RefreshAsync()" />
</PDToolbar>

@if (Statuses is null)
{
    <p>Reading the recorders...</p>
}
else
{
    @if (Combined is not null)
    {
        <section class="card border-2 @(Combined.Missing.Count == 0 ? "border-success" : "border-warning") mb-3" id="station-coverage" aria-label="Station coverage, A and B together">
            <div class="card-header d-flex align-items-center flex-wrap gap-2">
                <PDLabel Text="@(Combined.Missing.Count == 0 ? "COMPLETE" : "MISSING AUDIO")" IconCssClass="@(Combined.Missing.Count == 0 ? "fas fa-check-circle" : "fas fa-exclamation-triangle")"
                         CssClass="@($"badge {(Combined.Missing.Count == 0 ? "text-bg-success" : "text-bg-warning")} status-badge")" />
                <strong>Station: A and B together</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Coverage by any recorder, last 24 hours</span>
                        <span>@CombinedText</span>
                    </div>
                    <PDProgressBar Value="@(Combined.Fraction * 100)" Total="100" DecimalPlaces="1" Height="1.25rem" />
                </div>
                <p class="small fw-semibold mb-1">Missing from both recorders, last 24 hours</p>
                @if (Combined.Missing.Count == 0)
                {
                    <p class="mb-0">None: every moment was recorded by at least one recorder.</p>
                }
                else
                {
                    <ul class="mb-0" id="station-missing">
                        @foreach (var g in Combined.Missing.Reverse().Take(MaxMissingShown))
                        {
                            <li class="utc">@Utc(g.Start) to @Utc(g.End) (@Duration(g.Seconds))</li>
                        }
                    </ul>
                    @if (Combined.Missing.Count > MaxMissingShown)
                    {
                        <p class="small text-body-secondary mb-0">and @(Combined.Missing.Count - MaxMissingShown) earlier; see the Recordings calendar.</p>
                    }
                }
            </div>
        </section>
    }
    @if (Consolidation is not null)
    {
        <section class="card border-2 @BorderClass(Consolidation.Level) mb-3" data-card="consolidation" data-level="@Consolidation.Level" aria-label="Consolidation">
            <div class="card-header d-flex align-items-center flex-wrap gap-2">
                <PDLabel Text="@LevelText(Consolidation.Level)" IconCssClass="@LevelIcon(Consolidation.Level)" CssClass="@($"badge {BadgeClass(Consolidation.Level)} status-badge")" />
                <strong>Consolidation</strong>
                <a class="ms-auto small" href="consolidation">Review originals ready to delete</a>
            </div>
            <div class="card-body">
                <p class="mb-2">@Consolidation.Summary</p>
                @if (Consolidation.Health is { } c)
                {
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr><th scope="row">Mode</th><td>@c.Mode</td></tr>
                            <tr><th scope="row">Last merged hour</th><td class="utc">@Utc(c.LastMergedHourUtc)</td></tr>
                            <tr><th scope="row">Backlog</th><td>@c.BacklogHours @(c.BacklogHours == 1 ? "hour" : "hours")</td></tr>
                            <tr><th scope="row">Waiting for analysis</th><td>@c.WaitingForAnalysis @(c.WaitingForAnalysis == 1 ? "hour" : "hours")</td></tr>
                            <tr>
                                <th scope="row">Failures</th>
                                <td>
                                    @if (c.Failures.Count == 0)
                                    {
                                        <span>none</span>
                                    }
                                    else
                                    {
                                        <ul class="mb-0 ps-3">
                                            @foreach (var f in c.Failures)
                                            {
                                                <li><span class="utc">@Utc(f.HourUtc)</span>: @f.Reason</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                            <tr><th scope="row">Held originals</th><td>@c.Held</td></tr>
                            <tr><th scope="row">Ready to delete</th><td>@c.Ready</td></tr>
                            <tr><th scope="row">Space freed</th><td>@Bytes(c.DeletedBytes)</td></tr>
                        </tbody>
                    </table>
                }
            </div>
        </section>
    }
    <div class="row g-3">
        @foreach (var s in Statuses)
        {
            <div class="col-12 col-xl-6">
                <section class="card border-2 @BorderClass(s.Level)" data-recorder="@s.Recorder.Id" data-level="@s.Level" aria-label="Recorder @s.Recorder.Label">
                    <div class="card-header d-flex align-items-center flex-wrap gap-2">
                        <PDLabel Text="@LevelText(s.Level)" IconCssClass="@LevelIcon(s.Level)" CssClass="@($"badge {BadgeClass(s.Level)} status-badge")" />
                        <strong>Recorder @s.Recorder.Label</strong>
                        <span class="ms-auto text-body-secondary small">@(s.Health?.Instance ?? "")</span>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">@s.Summary</p>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Coverage, last 24 hours</span>
                                <span>@Coverage(s)</span>
                            </div>
                            <PDProgressBar Value="@(s.Coverage24hFraction * 100)" Total="100" DecimalPlaces="1" Height="1.25rem" />
                        </div>
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><th scope="row">Connected</th><td>@YesNo(s.Health?.Connected)</td></tr>
                                <tr><th scope="row">Seconds since last frame written</th><td>@Seconds(s.Health?.SecondsSinceLastFrame)</td></tr>
                                <tr><th scope="row">Last error</th><td>@LastError(s.Health)</td></tr>
                                <tr><th scope="row">Current segment start</th><td class="utc">@Utc(s.Health?.CurrentSegmentStartUtc)</td></tr>
                                <tr><th scope="row">Reconnects</th><td>@(s.Health?.Reachable == true ? s.Health.Reconnects.ToString(CultureInfo.InvariantCulture) : "-")</td></tr>
                                <tr><th scope="row">Recorder uptime</th><td>@Uptime(s.Health?.UptimeSeconds)</td></tr>
                                <tr><th scope="row">Latest segment</th><td class="utc">@Latest(s)</td></tr>
                                <tr><th scope="row">Data root</th><td><code>@s.Recorder.Root</code> (read-only)</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        }
    </div>
    <p class="small text-body-secondary mt-3">
        Green: connected and a frame written in the last @StatusRules.GreenSeconds s. Amber: reconnecting, a recent write error,
        frames late, or no health URL. Red: health check unreachable or no frame for over @StatusRules.RedSeconds s.
        Coverage counts closed segments from their sidecars (minus gaps) and the open segment up to its last write.
    </p>
}
