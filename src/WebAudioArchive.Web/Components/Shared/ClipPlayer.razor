@* The one place the audio player lives: PDMediaPlayer (PanoramicData.Blazor) for transport, speed, seek bar, markers,
   segments and download, plus the UTC wall time of the current position, which the player itself does not know. *@
<div class="clip-player card" id="clip-player">
    <div class="card-body">
        <PDMediaPlayer @key="Src"
                       Src="@Src"
                       Title="@Title"
                       PlaybackRates="Speeds"
                       SkipBackSeconds="15"
                       SkipForwardSeconds="30"
                       ShowDownload="true"
                       DownloadUrl="@DownloadUrl"
                       DownloadFileName="@DownloadName"
                       Markers="Markers"
                       Segments="Segments"
                       RangeStart="RangeStart"
                       RangeEnd="RangeEnd"
                       KindLabels="ClipMarkers.KindLabels"
                       KindColors="ClipMarkers.KindColors"
                       MarkerListExpanded="MarkerListExpanded"
                       MarkerListMaxHeight="12rem"
                       ShowErrors="true"
                       OnTimeUpdate="OnTimeUpdate"
                       OnError="OnError" />
        <div class="d-flex flex-wrap gap-3 small mt-2 clip-player-clock">
            <span>Wall time <strong id="clip-wall" class="utc">@WallText</strong> UTC</span>
            <span class="text-body-secondary">Position in clip <span id="clip-position">@PositionText</span> of @DurationText</span>
            <span class="text-body-secondary">File <code>@DownloadName</code></span>
        </div>
    </div>
</div>
