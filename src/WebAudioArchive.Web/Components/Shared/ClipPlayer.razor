@* The one place the audio player lives: PDMediaPlayer (PanoramicData.Blazor) for transport, speed, seek bar, markers,
   segments and download, plus the UTC wall time of the current position, which the player itself does not know. Its own
   marker and segment lists are off: the show page lists events beside the transcript instead. *@
<div class="clip-player card" id="clip-player">
    <div class="card-body p-2">
        <PDMediaPlayer @key="Src"
                       @ref="_player"
                       Src="@Src"
                       Title="@Title"
                       PlaybackRates="Speeds"
                       SkipBackSeconds="15"
                       SkipForwardSeconds="30"
                       ShowDownload="true"
                       DownloadUrl="@DownloadUrl"
                       DownloadFileName="@DownloadName"
                       StartAt="StartAt"
                       Markers="ShownMarkers"
                       Segments="ShownSegments"
                       RangeStart="RangeStart"
                       RangeEnd="RangeEnd"
                       KindLabels="ShowEvents.KindLabels"
                       KindColors="ShowEvents.KindColors"
                       ShowKindFilter="false"
                       ShowMarkerList="false"
                       ShowSegmentList="false"
                       ShowNowPlaying="false"
                       ShowErrors="true"
                       OnSegmentSelected="OnSegmentSelected"
                       OnMarkerSelected="OnMarkerSelected"
                       OnTimeUpdate="OnTimeUpdate"
                       OnError="OnError" />
        <div class="d-flex flex-wrap column-gap-3 small clip-player-clock">
            <span>Wall time <strong id="clip-wall" class="utc">@WallText</strong> UTC</span>
            <span class="text-body-secondary">Position in clip <span id="clip-position">@PositionText</span> of @DurationText</span>
            <span class="text-body-secondary">File <code>@DownloadName</code></span>
        </div>
    </div>
</div>
