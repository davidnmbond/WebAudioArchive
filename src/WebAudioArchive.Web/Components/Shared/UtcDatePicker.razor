@* The only place a date is picked: a thin wrapper over PDDateTime that treats its value as a UTC calendar date (no
   time zone conversion). A later job swaps this for PDCalendar; callers only see a UTC DateOnly. *@
<div class="utc-date-picker" id="@Id">
    <label class="form-label mb-1 small">@Label</label>
    <PDDateTime Value="@Shown" ValueChanged="OnChangedAsync" IsEnabled="@IsEnabled" CssClass="utc-date" />
</div>
